# Render Environment Variables (production)
# Bu faylni Render dashboard'dagi Environment Variables bo'limiga qo'shing

# Neon Postgres connection string
DATABASE_URL="postgresql://neondb_owner:PAROL@ep-xxx.neon.tech/neondb?sslmode=require"

# Kuchli JWT secret (kamida 32 belgi, tasodifiy)
# Masalan: openssl rand -hex 32 buyrug'i bilan hosil qiling
JWT_SECRET="production-da-bu-o'ringa-kuchli-maxfiy-so'z-qo'ying"

# Port - Render o'zi beradi, siz o'zgartirmang
PORT=4000
